{
  "name": "philter",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "build:cli": "pnpm --filter @philter/common build && pnpm --filter @philter/cli build",
    "build:e2e": "pnpm --filter @philter/common build && pnpm --filter @philter/e2e-tests build",
    "build:manager": "pnpm --filter @philter/common build && pnpm --filter @philter/api build && pnpm --filter @philter/manager build",
    "lint": "eslint ."
  },
  "eslintConfig": {
    "extends": "./node_modules/gts/",
    "rules": {
      "node/no-unpublished-import": [
        "error",
        {
          "allowModules": [
            "kolmafia"
          ]
        }
      ]
    },
    "ignorePatterns": [
      "/packages/*/build/",
      "/release/"
    ]
  }
}
