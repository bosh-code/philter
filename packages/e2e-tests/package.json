{
  "name": "@philter/e2e-tests",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end test scripts for Philter",
  "repository": "https://github.com/Loathing-Associates-Scripting-Society/Philter",
  "license": "MIT",
  "author": "Yehyoung Kang",
  "main": "index.js",
  "scripts": {
    "build": "rollup --configPlugin typescript -c rollup.config.ts",
    "clean": "gts clean",
    "compile": "tsc -b",
    "fix": "eslint --fix .",
    "lint": "eslint .",
    "pretest": "pnpm run compile",
    "test": "echo \"Error: no test specified\"",
    "posttest": "pnpm run lint"
  },
  "eslintConfig": {
    "parserOptions": {
      "sourceType": "module"
    }
  },
  "dependencies": {
    "@philter/common": "workspace:*",
    "@types/minimist": "^1.2.5",
    "kolmafia": "npm:kolmafia-types",
    "kolmafia-util": "^0.3.0",
    "minimist": "^1.2.8",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "buble-config-rhino": "^0.1.0",
    "gts": "^6.0.2",
    "rollup": "^4.40.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
