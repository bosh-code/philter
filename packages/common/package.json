{
  "name": "@philter/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./build/src/index.js",
    "./kol": "./build/src/kol/index.js"
  },
  "typesVersions": {
    "*": {
      "kol": [
        "./build/src/kol/index.d.ts"
      ],
      "*": [
        "./build/src/*"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf ./build && tsc",
    "lint": "eslint src && prettier --check .",
    "format": "eslint src --fix && prettier --write .",
    "madge": "madge --circular . ./src/index.ts",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "kolmafia": "^5.28389.0",
    "kolmafia-types": "0.3.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-plugin-n": "^17.18.0",
    "gts": "^3.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "^4.3.2"
  }
}
